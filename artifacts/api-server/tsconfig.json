{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "noImplicitReturns": false,
    // Vercel transpiles traced Express files one at a time. Keep type safety in
    // the explicit `typecheck` script, but do not let its incremental emitter
    // stop on transient monorepo module-resolution diagnostics.
    "noEmitOnError": false
  },
  "include": ["src"],
  "references": [
    {
      "path": "../../lib/db"
    },
    {
      "path": "../../lib/api-zod"
    }
  ]
}
