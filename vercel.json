{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node scripts/vercel-ignore.mjs web",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://bikalima-api-server.vercel.app/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
